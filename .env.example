# Supabase Configuration (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Keep this secret and never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: direct Postgres connection string for local tooling (never ship to client)
# SUPABASE_DB_URL=postgresql://postgres:[YOUR_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# AI Assistant Configuration
# Primary: DeepSeek API (Recommended)
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Fallback: HuggingFace API (Optional)
# HF_TOKEN=your-huggingface-token
# HF_BASE_URL=https://router.huggingface.co/v1
# HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Fallback: OpenAI API (Optional)
# OPENAI_API_KEY=your-openai-api-key

# Site URL for production
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
